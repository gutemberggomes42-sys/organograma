rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public access is enabled at the owner's request for faster collaboration.
    // Anyone who can reach the app can read and modify these shared documents.
    match /appData/organization {
      allow read, write: if true;
    }
    match /appData/roster {
      allow read, write: if true;
    }
    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
  }
}
